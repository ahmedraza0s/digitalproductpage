# ── App ──────────────────────────────────────────
PORT=5000
NODE_ENV=production
BASE_URL=https://yourdomain.com

# ── MongoDB ───────────────────────────────────────
MONGODB_URI=

# ── Razorpay ──────────────────────────────────────
RAZORPAY_KEY_ID=
