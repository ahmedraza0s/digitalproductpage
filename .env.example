RAZORPAY_WEBHOOK_SECRET=

# ── Download Security ─────────────────────────────
DOWNLOAD_TOKEN_SECRET=
TOKEN_EXPIRY_HOURS=48
MAX_DOWNLOADS_PER_PURCHASE=10

# ── Email ─────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── Admin Panel ───────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRY=8h
